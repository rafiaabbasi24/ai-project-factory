# ==============================
# AI PROJECT FACTORY CONFIG
# ==============================

# n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Kolkata
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Groq
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
# Current production-capable code/reasoning model. Change anytime if Groq changes availability.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# GitHub
GITHUB_TOKEN=PASTE_YOUR_GITHUB_TOKEN_HERE
GITHUB_OWNER=PASTE_YOUR_GITHUB_USERNAME_HERE
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main
PROJECT_VISIBILITY=public

# Hugging Face (optional for public API endpoints, recommended for higher limits)
HF_TOKEN=
HF_API_URL=https://huggingface.co/api

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_REST_URL=https://YOUR_PROJECT.supabase.co/rest/v1

# Daily factory settings
PUBLISH_HOUR=8
PUBLISH_MINUTE=0
MAX_FILES=14
MAX_SOURCE_ITEMS=5
MAX_GENERATION_RETRIES=2
PROJECT_OWNER_NAME=Azam Abbasi
PROJECT_GITHUB_PREFIX=ai-daily-

# Categories rotate automatically unless you override the list.
PROJECT_CATEGORIES=LLM,Generative AI,Machine Learning,Deep Learning,NLP,Transformers,Reinforcement Learning

# Optional notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
